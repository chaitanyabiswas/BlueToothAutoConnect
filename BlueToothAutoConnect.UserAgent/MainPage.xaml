<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BlueToothAutoConnect_UserAgent.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BlueToothAutoConnect_UserAgent"
    xmlns:models="using:BlueToothAutoConnect.PolicyEngine.Models"
    xmlns:persistence="using:BlueToothAutoConnect.Persistence.Entities"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid Margin="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Status bar -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Image x:Name="AppLogo" Width="32" Height="32" VerticalAlignment="Center"
                   AutomationProperties.Name="Bluetooth Auto Connect logo"/>
            <TextBlock Text="Bluetooth Auto Connect" Style="{StaticResource TitleTextBlockStyle}"/>
            <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                    CornerRadius="4" Padding="8,2"
                    Visibility="{x:Bind ViewModel.ServiceStatus, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}" FontSize="12"/>
            </Border>
            <Button Content="Open diagnostic logs" Click="OnOpenDiagnosticLogsClick"/>
        </StackPanel>

        <!-- Main content: devices + whitelist side by side -->
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Discovered Devices -->
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Discovered Devices" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.DeviceDiscoveryStatus, Mode=OneWay}" VerticalAlignment="Center"/>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsDeviceDiscoveryLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsDeviceDiscoveryLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Refresh" Click="OnRefreshDevicesClick"/>
                </StackPanel>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Devices, Mode=OneWay}"
                          SelectionMode="Single" x:Name="DevicesList">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:DeviceInfo">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Address}" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Paired" FontSize="11"
                                                   Visibility="{x:Bind IsPaired, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                        <TextBlock Text="Connected" FontSize="11"
                                                   Visibility="{x:Bind IsConnected, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Trust" Tag="{x:Bind}"
                                        Click="OnTrustDeviceClick" Padding="8,4"/>
                                <Button Grid.Column="2" Content="Connect" Tag="{x:Bind}"
                                        Click="OnConnectDeviceClick" Padding="8,4"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Whitelist -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Trusted Devices (Whitelist)" Style="{StaticResource SubtitleTextBlockStyle}"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.WhitelistStatus, Mode=OneWay}" VerticalAlignment="Center"/>
                    <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsWhitelistLoading, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsWhitelistLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Refresh" Click="OnRefreshWhitelistClick"/>
                </StackPanel>
                <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.WhitelistEntries, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="persistence:WhitelistEntry">
                            <Grid Padding="0,4" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{x:Bind FriendlyName}" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="MAC:" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind DeviceAddress}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Name:" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind DeviceName}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Category:" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind Category}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Remove" Tag="{x:Bind}"
                                        Click="OnRemoveWhitelistClick" Padding="8,4"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- Log panel -->
        <Grid Grid.Row="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Activity Log" Style="{StaticResource CaptionTextBlockStyle}"/>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Logs, Mode=OneWay}"
                      FontFamily="Consolas" FontSize="11">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="4,1"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Grid>
    </Grid>
</Page>
