<?xml version="1.0" encoding="UTF-8"?>
<!--
  BlueToothAutoConnect MSI — Product.wxs (WiX v4)

  Defines structure only. All File elements live in generated fragments:
    HostHarvest.wxs   → CG_PrivilegedHostHarvested  (runtime DLLs etc.)
    AgentHarvest.wxs  → CG_UserAgentHarvested        (runtime DLLs etc.)
    HostKeyFiles.wxs  → CG_PrivilegedHost            (EXE + service install)
    AgentKeyFiles.wxs → CG_UserAgent                 (EXE, DLL, runtimeconfig)
  All four are generated by build-installer.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!-- .NET 8 x64 Runtime prerequisite.
       Native MSI AppSearch/RegLocator search.
       Bitness="always64" reads the 64-bit hive where dotnet actually writes.
       Property must be inside Package (not Fragment) to generate AppSearch table. -->


  <Package
    Name="Bluetooth Auto Connect"
    Manufacturer="BlueToothAutoConnect"
    Version="$(ProductVersion)"
    UpgradeCode="A3F2C1D4-5E6B-4A7C-8D9E-0F1A2B3C4D5E"
    Language="1033"
    Codepage="1252"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perMachine">

    <Media Id="1" Cabinet="BlueToothAutoConnect.cab" EmbedCab="yes" />

    <MajorUpgrade
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of Bluetooth Auto Connect is already installed. Please uninstall it first." />

    <Launch
      Condition="DOTNETVERSION OR Installed"
      Message=".NET 8 Runtime (x64) is required.&#13;&#10;Download from: https://dotnet.microsoft.com/download/dotnet/8" />

    <!-- Reads dotnet sharedhost Version value from the 64-bit registry hive.
         Populated by AppSearch before LaunchConditions fires. -->
    <Property Id="DOTNETVERSION">
      <RegistrySearch Id="NetCore8Search"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedhost"
                      Name="Version"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <!-- ── Directory layout ──────────────────────────────────────── -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BlueToothAutoConnect">
        <Directory Id="ServiceFolder"   Name="Service" />
        <Directory Id="UserAgentFolder" Name="UserAgent" />
        <Directory Id="UserAgentCliFolder" Name="UserAgentCli" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Bluetooth Auto Connect" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="CommonAppDataManufacturerFolder" Name="BlueToothAutoConnect" />
    </StandardDirectory>

    <!-- ── ProgramData permissions for SQLite DB ──────────────────── -->
    <ComponentGroup Id="CG_CommonAppData" Directory="CommonAppDataManufacturerFolder">
      <Component Id="C_CommonAppDataFolder" Guid="D4E5F6A7-B8C9-0D1E-2F3A-4B5C6D7E8F9A" Bitness="always64">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <!-- ── Start Menu shortcut ───────────────────────────────────── -->
    <ComponentGroup Id="CG_Shortcuts" Directory="AppMenuFolder">
      <Component Id="C_StartMenuShortcut" Guid="B3C4D5E6-F7A8-B9C0-1D2E-3F4A5B6C7D8E" Bitness="always64">
        <Shortcut Id="AgentStartMenuShortcut"
                  Name="Bluetooth Auto Connect"
                  Description="Manage trusted Bluetooth devices and monitor connection status"
                  Target="[UserAgentFolder]BlueToothAutoConnect.UserAgent.exe"
                  WorkingDirectory="UserAgentFolder"
                  Icon="AppIcon.ico" />
        <Shortcut Id="AgentBackgroundStartMenuShortcut"
                  Name="Bluetooth Auto Connect (Background)"
                  Description="Start Bluetooth Auto Connect in the notification area"
                  Target="[UserAgentFolder]BlueToothAutoConnect.UserAgent.exe"
                  Arguments="--background"
                  WorkingDirectory="UserAgentFolder"
                  Icon="AppIcon.ico" />
        <RegistryValue
          Root="HKCU"
          Key="Software\BlueToothAutoConnect"
          Name="StartMenuInstalled"
          Value="1"
          Type="integer"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="CG_DesktopShortcut" Directory="DesktopFolder">
      <Component Id="C_DesktopShortcut"
                 Guid="D8E9F0A1-B2C3-4D5E-8F7A-9B0C1D2E3F4A"
                 Bitness="always64"
                 Condition="CREATE_DESKTOP_SHORTCUT = &quot;1&quot;">
        <Shortcut Id="AgentDesktopShortcut"
                  Name="Bluetooth Auto Connect"
                  Description="Manage trusted Bluetooth devices and monitor connection status"
                  Target="[UserAgentFolder]BlueToothAutoConnect.UserAgent.exe"
                  WorkingDirectory="UserAgentFolder"
                  Icon="AppIcon.ico" />
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\BlueToothAutoConnect\Installer"
          Name="DesktopShortcutInstalled"
          Value="1"
          Type="integer"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── Icon and ARP ──────────────────────────────────────────── -->
    <Icon Id="AppIcon.ico" SourceFile="Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON"  Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/BlueToothAutoConnect" />
    <Property Id="ARPHELPLINK"     Value="https://github.com/BlueToothAutoConnect" />

    <!-- ── Installer UI ─────────────────────────────────────────── -->
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="0" Secure="yes" />
    <ui:WixUI Id="WixUI_InstallDir_Custom" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="Assets\License.rtf" />

    <!-- ── Features ─────────────────────────────────────────────── -->
    <Feature Id="F_Complete"
             Title="Bluetooth Auto Connect"
             Description="Installs the Bluetooth Auto Connect service and user interface."
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">

      <Feature Id="F_Service"
               Title="Privileged Host Service"
               Description="Windows Service for elevated Bluetooth operations. Required."
               Level="1"
               AllowAdvertise="no">
        <ComponentGroupRef Id="CG_PrivilegedHost" />
        <ComponentGroupRef Id="CG_PrivilegedHostHarvested" />
        <ComponentGroupRef Id="CG_CommonAppData" />
      </Feature>

      <Feature Id="F_UserAgent"
               Title="User Agent (UI &amp; CLI)"
               Description="WinUI 3 application and CLI tool for device management. Auto-starts at login."
               Level="1"
               AllowAdvertise="no">
        <ComponentGroupRef Id="CG_UserAgent" />
        <ComponentGroupRef Id="CG_UserAgentHarvested" />
        <ComponentGroupRef Id="CG_UserAgentCli" />
        <ComponentGroupRef Id="CG_UserAgentCliHarvested" />
        <ComponentGroupRef Id="CG_Shortcuts" />
        <ComponentGroupRef Id="CG_DesktopShortcut" />
        <ComponentGroupRef Id="CG_AutoStart" />
      </Feature>

    </Feature>

  </Package>
</Wix>
