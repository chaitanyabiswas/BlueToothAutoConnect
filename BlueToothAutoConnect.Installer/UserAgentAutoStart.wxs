<?xml version="1.0" encoding="UTF-8"?>
<!--
  UserAgentAutoStart.wxs — WiX v4 fragment
  ─────────────────────────────────────────
  Registers / removes a Windows Task Scheduler logon task for the UserAgent.

  Task:    BlueToothAutoConnect\UserAgent
  Trigger: ONLOGON, delay 30 s
  Action:  <UserAgentFolder>\BlueToothAutoConnect.UserAgent.exe
  User:    SYSTEM (schtasks scheduled by installer); task itself launches the
           UserAgent under the logged-on user's token via ONLOGON trigger with
           no explicit /RU, so it runs as the triggering user.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>

    <!-- ── Registry component: tracks install state ─────────────── -->
    <ComponentGroup Id="CG_AutoStart" Directory="UserAgentFolder">
      <Component Id="C_AutoStartMarker" Guid="A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D" Bitness="always64">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\BlueToothAutoConnect"
          Name="UserAgentAutoStartInstalled"
          Value="1"
          Type="integer"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ── Custom actions: schtasks via SystemFolder ─────────────── -->

    <!--
      Create the logon task.
      Directory="SystemFolder" tells MSI to set the working directory to
      %SystemRoot%\System32 and evaluate [SystemFolder] in ExeCommand.
      Execute="deferred" + Impersonate="no" → runs elevated as SYSTEM.
      Return="ignore" → won't fail install if schtasks returns non-zero.
    -->
    <CustomAction
      Id="CA_CreateAutoStartTask"
      Directory="SystemFolder"
      ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Create /F /SC ONLOGON /DELAY 0000:30 /TN &quot;BlueToothAutoConnect\UserAgent&quot; /TR &quot;&quot;&quot;[UserAgentFolder]BlueToothAutoConnect.UserAgent.exe&quot;&quot;&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!--
      Delete the task on uninstall.
    -->
    <CustomAction
      Id="CA_DeleteAutoStartTask"
      Directory="SystemFolder"
      ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /F /TN &quot;BlueToothAutoConnect\UserAgent&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!--
      Rollback: delete the task if the install fails after task creation.
    -->
    <CustomAction
      Id="CA_RollbackAutoStartTask"
      Directory="SystemFolder"
      ExeCommand="&quot;[SystemFolder]schtasks.exe&quot; /Delete /F /TN &quot;BlueToothAutoConnect\UserAgent&quot;"
      Execute="rollback"
      Impersonate="no"
      Return="ignore" />

    <!-- ── Sequence ──────────────────────────────────────────────── -->
    <InstallExecuteSequence>

      <!-- Register rollback cleanup just before creating the task -->
      <Custom Action="CA_RollbackAutoStartTask"
              After="InstallFiles"
              Condition="NOT Installed" />

      <!-- Create the task after files land, install/repair only -->
      <Custom Action="CA_CreateAutoStartTask"
              After="CA_RollbackAutoStartTask"
              Condition="NOT Installed" />

      <!-- Delete the task on full uninstall, after services stop -->
      <Custom Action="CA_DeleteAutoStartTask"
              After="StopServices"
              Condition="Installed AND REMOVE=&quot;ALL&quot;" />

    </InstallExecuteSequence>

  </Fragment>

</Wix>
