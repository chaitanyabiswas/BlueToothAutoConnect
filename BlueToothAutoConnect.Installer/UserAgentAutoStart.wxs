<?xml version="1.0" encoding="UTF-8"?>
<!--
  UserAgentAutoStart.wxs — WiX v4 fragment
  ─────────────────────────────────────────
  Registers the UserAgent to start in the notification area for each user
  when they sign in. The Windows Run key launches it in that user's session.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Fragment>

    <!-- ── Registry components ─────────────────────────────────── -->
    <ComponentGroup Id="CG_AutoStart" Directory="UserAgentFolder">
      <Component Id="C_AutoStartMarker" Guid="A6B7C8D9-E0F1-2A3B-4C5D-6E7F8A9B0C1D" Bitness="always64">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\BlueToothAutoConnect"
          Name="UserAgentAutoStartInstalled"
          Value="1"
          Type="integer"
          KeyPath="yes" />
      </Component>
      <Component Id="C_UserAgentAutoStart" Guid="C8D9E0F1-2A3B-4C5D-6E7F-8A9B0C1D2E3F" Bitness="always64">
        <RegistryValue
          Root="HKLM"
          Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run"
          Name="BlueToothAutoConnect"
          Value="&quot;[UserAgentFolder]BlueToothAutoConnect.UserAgent.exe&quot; --background"
          Type="string"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

  </Fragment>
</Wix>
